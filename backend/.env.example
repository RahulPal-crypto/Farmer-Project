PORT=5000
NODE_ENV=development
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=your-jwt-secret
CLIENT_URL=http://localhost:5173

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Razorpay (replace with your test/production keys)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Market price data (Data.gov.in)
MARKET_API_URL=https://api.data.gov.in/resource/YOUR_RESOURCE_ID?format=json&limit=500
MARKET_API_KEY=your-data-gov-api-key
MARKET_CRON_SCHEDULE=30 0 * * *
MARKET_DEFAULT_UNIT=kg

# Do NOT commit your real .env file. Add secrets here for local testing only.
PORT=5000
NODE_ENV=development
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=your-super-secret-jwt-key

# Comma-separated frontend origins allowed to call this API.
# Production example:
# CLIENT_URL=https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Optional. Use this if your host sits behind a proxy and image URLs need an explicit backend URL.
# API_PUBLIC_URL=https://your-backend-domain.com

# Required in production for persistent product images.
# Local disk uploads are only suitable for development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only if Razorpay checkout is enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
