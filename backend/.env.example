PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/farmer-market?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key
CLIENT_URL=http://localhost:5173

# Optional: Host URL if behind a proxy
# API_PUBLIC_URL=http://localhost:5000

# Cloudinary (optional for dev, recommended in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Razorpay (replace with your test/production keys)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Market price data (Data.gov.in)
MARKET_API_URL=https://api.data.gov.in/resource/YOUR_RESOURCE_ID?format=json&limit=500
MARKET_API_KEY=your-data-gov-api-key
MARKET_CRON_SCHEDULE=30 0 * * *
MARKET_DEFAULT_UNIT=kg

# WhatsApp & SMS Alerts (Twilio Free Sandbox for live testing)
# Sign up free at https://www.twilio.com -> Messaging -> Try WhatsApp
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional standard SMS fallback if recipient phone is not registered on WhatsApp
# TWILIO_PHONE_NUMBER=+1234567890
